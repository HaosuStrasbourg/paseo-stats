{
  "name": "paseo-stats",
  "version": "0.1.0",
  "description": "Paseo plugin: stat pills and cards for Claude Code and Grok agents (quota, speed, tokens, files changed, daily heatmap). Reads local files only.",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "claude-code",
    "grok",
    "usage",
    "tokens"
  ],
  "license": "MIT",
  "files": [
    "paseo-plugin.json",
    "index.client.tsx",
    "index.server.ts",
    "client/",
    "server/",
    "shared/",
    "scripts/",
    "README.md",
    "LICENSE",
    "README.zh-CN.md",
    "images/"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "stats": "node scripts/stats-cli.ts"
  },
  "devDependencies": {
    "@getpaseo/plugin": "0.10.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^22.15.3",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  },
  "author": "HaosuStrasbourg",
  "repository": {
    "type": "git",
    "url": "https://github.com/HaosuStrasbourg/paseo-stats.git"
  },
